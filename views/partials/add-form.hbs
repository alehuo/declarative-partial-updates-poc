<div>
  <input type="hidden" name="_csrf" value="{{csrf}}">
  <label for="title" class="sr-only">New TODO</label>
  <div class="flex gap-2">
    <input id="title" name="title" value="{{value}}" maxlength="200" autocomplete="off" required autofocus
      placeholder="What needs doing?"
      class="flex-1 rounded-lg border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:outline-none">
    <button class="rounded-lg bg-indigo-600 px-4 py-2 font-medium text-white hover:bg-indigo-700 focus-visible:ring-2 focus-visible:ring-indigo-300 aria-busy:opacity-60">
      Add
    </button>
  </div>
  {{#if error}}<p class="mt-2 text-sm text-rose-600" role="alert">{{error}}</p>{{/if}}
</div>

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TODO · Declarative Partial Updates PoC</title>
  <link rel="stylesheet" href="/app.css">
</head>
<body class="min-h-screen bg-slate-100 text-slate-800 antialiased">
  <main class="mx-auto max-w-xl px-4 py-12">
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">TODOs</h1>
      <p class="mt-1 text-sm text-slate-500">
        Streamed with <code class="rounded bg-slate-200 px-1">&lt;template for&gt;</code> patches
      </p>
    </header>

    <form method="post" action="/todos" class="mb-6 rounded-xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
      {{{form}}}
    </form>

    <section class="rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
      <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">List</h2>
        <p class="text-sm text-slate-500" aria-live="polite">{{{count}}}</p>
      </div>
      <ul id="todos" class="divide-y divide-slate-100">
        <li class="hidden px-4 py-8 text-center text-slate-400 only:block">Nothing to do 🎉</li>
        {{pi "start" "todo-list"}}<li class="animate-pulse px-4 py-3 text-slate-400">Loading…</li>{{pi "end"}}
      </ul>
    </section>
  </main>
